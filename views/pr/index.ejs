<!doctype html>
<html lang="en" data-color-mode="<%= colorMode %>" data-light-theme="light" data-dark-theme="dark">
<head>
  <%- include('../partials/head', { title: 'Pull requests · ' + repo.name }) %>
</head>
<%
  // Octicons, at the sizes GitHub uses them.
  const octicon = (path, size = 16) =>
    `<svg class="octicon" viewBox="0 0 16 16" width="${size}" height="${size}" aria-hidden="true"><path d="${path}"></path></svg>`;
  const icon = {
    repo: octicon('M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z'),
    pull: octicon('M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z'),
    merged: octicon('M5.45 5.154A4.25 4.25 0 0 0 9.25 7.5h1.378a2.251 2.251 0 1 1 0 1.5H9.25A5.734 5.734 0 0 1 5 7.123v3.505a2.25 2.25 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.95-.218ZM4.25 13.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm8.5-4.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM5 3.25a.75.75 0 1 0 0 .005V3.25Z'),
    closed: octicon('M3.25 1A2.25 2.25 0 0 1 4 5.372v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.251 2.251 0 0 1 3.25 1Zm9.5 5.5a.75.75 0 0 1 .75.75v3.378a2.251 2.251 0 1 1-1.5 0V7.25a.75.75 0 0 1 .75-.75Zm-8.5 6.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0ZM14 12.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0ZM3.25 3.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm10.28-1.72-4.5 4.5a.75.75 0 0 1-1.06-1.06l4.5-4.5a.75.75 0 1 1 1.06 1.06Z'),
    check: octicon('M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z'),
    comment: octicon('M2.75 2.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h2a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h4.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Zm-1.75.25c0-.966.784-1.75 1.75-1.75h10.5c.966 0 1.75.784 1.75 1.75v7.5a1.75 1.75 0 0 1-1.75 1.75H8.06l-2.573 2.573A1.458 1.458 0 0 1 3 13.543V12H2.75A1.75 1.75 0 0 1 1 10.25Z'),
    search: octicon('M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z'),
    trash: octicon('M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z'),
    compare: octicon('M9.22 1.22a.75.75 0 0 1 1.06 0l2.5 2.5a.75.75 0 0 1 0 1.06l-2.5 2.5a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L10.44 5H8.75a3.25 3.25 0 0 0-3.25 3.25v5a.75.75 0 0 1-1.5 0v-5A4.75 4.75 0 0 1 8.75 3.5h1.69L9.22 2.28a.75.75 0 0 1 0-1.06ZM4.5 2.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2ZM1.5 3.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm10 8a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm-3 1a3 3 0 1 1 6 0 3 3 0 0 1-6 0Z'),
  };
  const stateIcon = { open: icon.pull, draft: icon.pull, merged: icon.merged, closed: icon.closed };
  const isOpen = (p) => p.state === 'open' || p.state === 'draft';
  const openCount = pulls.filter(isOpen).length;
  const closedCount = pulls.length - openCount;
%>
<body data-me="<%= me.handle %>">
  <!-- GitHub keeps this page quiet: where you are, then the work. -->
  <header class="index-header">
    <div class="index-header-inner">
      <span class="index-crumb"><%- icon.repo %><span class="index-crumb-path" title="<%= repoPath %>"><%= repoPath %></span></span>
      <span class="index-crumb-sep">/</span>
      <h1 class="index-heading">Pull requests</h1>
    </div>
  </header>

  <main class="index-main">
    <div class="index-toolbar">
      <span class="filter-input">
        <%- icon.search %>
        <input type="text" id="pr-filter" placeholder="Search pull requests" spellcheck="false"
               aria-label="Search pull requests" />
      </span>
      <button type="button" class="btn btn-primary" id="new-pr-toggle"
              aria-expanded="false" aria-controls="new-pr">New pull request</button>
    </div>

    <!-- Open a pull request against any repo on this machine. Which repo is
         picked here rather than fixed when the server started, so one prequel
         holds the reviews for everything you are working on. -->
    <section class="compare" id="new-pr" hidden>
      <div class="compare-head">
        <h2 class="compare-title">Compare changes</h2>
        <p class="compare-sub">Choose a repository and two branches to review.</p>
      </div>

      <div class="compare-bar">
        <span class="compare-group">
          <%- icon.repo %>
          <span class="ref-picker">
            <select id="new-repo" aria-label="Repository">
              <% repos.forEach(function (r) { %>
                <option value="<%= r.id %>" title="<%= r.root_path %>"
                        data-path="<%= r.root_path %>"
                        data-removable="<%= !r.home && !r.pull_count ? '1' : '' %>"><%= r.name %></option>
              <% }); %>
            </select>
          </span>
          <button type="button" class="btn btn-sm" id="repo-add">Add a folder…</button>
          <button type="button" class="btn btn-sm btn-icon btn-danger" id="repo-drop"
                  title="Forget this repository" aria-label="Forget this repository" hidden>
            <%- icon.trash %>
          </button>
        </span>

        <span class="compare-group compare-refs">
          <%- icon.compare %>
          <span class="ref-picker">
            <label for="new-base">base:</label>
            <select id="new-base" aria-label="Base branch"></select>
          </span>
          <span class="compare-arrow">←</span>
          <span class="ref-picker">
            <label for="new-head">compare:</label>
            <select id="new-head" aria-label="Compare branch"></select>
          </span>
        </span>
      </div>

      <div class="compare-status" id="new-pr-hint"></div>

      <div class="compare-form">
        <input type="text" class="compare-input compare-input-title" id="new-title"
               placeholder="Title" aria-label="Pull request title" />
        <textarea class="compare-input" id="new-body" rows="5"
                  aria-label="Pull request description"
                  placeholder="Add a description. Markdown is rendered on the Conversation tab."></textarea>
        <div class="compare-actions">
          <button type="button" class="btn" id="new-cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="new-create">Create pull request</button>
        </div>
      </div>
    </section>

    <div class="box">
      <div class="box-header">
        <span class="box-states">
          <button type="button" class="state-filter is-active" data-state="open">
            <%- icon.check %><span><strong id="count-open"><%= openCount %></strong> Open</span>
          </button>
          <button type="button" class="state-filter" data-state="closed">
            <span><strong id="count-closed"><%= closedCount %></strong> Closed</span>
          </button>
        </span>
        <% if (showRepo) { %>
          <span class="box-header-note"><%= repos.length %> repositories</span>
        <% } %>
      </div>

      <ul class="pr-list">
        <% pulls.forEach(function (p) { %>
          <li class="pr-list-item" data-pr="<%= p.number %>"
              data-state="<%= isOpen(p) ? 'open' : 'closed' %>"
              data-search="<%= (p.title + ' ' + p.head_ref + ' ' + p.base_ref + ' ' + p.repo_name + ' #' + p.number).toLowerCase() %>">
            <span class="pr-icon state-<%= p.state %>" title="<%= p.state %>"><%- stateIcon[p.state] || icon.pull %></span>
            <div class="pr-list-main">
              <a class="pr-list-title" href="/pr/<%= p.number %>"><%= p.title %></a>
              <div class="pr-list-meta">
                <span class="pr-list-line">
                  #<%= p.number %> opened <time datetime="<%= p.created_at %>"><%= p.created_at %></time>
                  by <%= p.author_handle %>
                </span>
                <span class="pr-list-refs">
                  <% if (showRepo) { %>
                    <span class="repo-tag" title="<%= p.repo_path %>"><%- icon.repo %><%= p.repo_name %></span>
                  <% } %>
                  <span class="ref-pill"><%= p.head_ref %></span>
                  <span class="ref-arrow">into</span>
                  <span class="ref-pill"><%= p.base_ref %></span>
                </span>
              </div>
            </div>
            <span class="pr-list-side">
              <% if (p.counts.open) { %>
                <span class="pr-open-count" title="<%= p.counts.open %> unresolved"><%= p.counts.open %> open</span>
              <% } %>
              <% p.verdicts.forEach(function (v) { %>
                <span class="verdict verdict-<%= v.verdict === 'approve' ? 'approve' : v.verdict === 'request_changes' ? 'changes' : 'comment' %>"
                      title="<%= v.handle %> <%= v.verdict.replace('_', ' ') %>"><%= v.handle %></span>
              <% }); %>
              <% if (p.counts.conversation + p.counts.files) { %>
                <a class="pr-threads" href="/pr/<%= p.number %>/files"
                   title="<%= p.counts.files %> file threads"><%- icon.comment %><%= p.counts.conversation + p.counts.files %></a>
              <% } %>
              <button type="button" class="pr-list-drop" data-pr="<%= p.number %>"
                      title="Delete this pull request" aria-label="Delete #<%= p.number %>">
                <%- icon.trash %>
              </button>
            </span>
          </li>
        <% }); %>
      </ul>

      <% if (!pulls.length) { %>
        <div class="box-blank">
          <%- icon.pull %>
          <p class="box-blank-title">No pull requests yet</p>
          <p class="box-blank-sub">Open one with <strong>New pull request</strong>, or over the API
            with <code>POST /api/pulls</code>.</p>
        </div>
      <% } %>
      <div class="box-blank" id="list-blank" hidden>
        <p class="box-blank-title">No pull requests matched</p>
        <p class="box-blank-sub">Try a different search, or look under Closed.</p>
      </div>
    </div>
  </main>

  <div id="toast" class="toast" hidden></div>
  <script src="/static/js/pulls.js" defer></script>
</body>
</html>
